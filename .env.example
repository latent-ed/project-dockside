# Copy to .env and fill in your own values. Never commit .env.

ENVIRONMENT=dev

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
S3_BUCKET=

# --- Snowflake ---
# If your password contains a comma, ! or @, wrap the value in double quotes.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- TfL ---
# Free to register, no card needed. Requests work without these, but
# unregistered access is rate limited — register anyway.
TFL_APP_ID=
TFL_APP_KEY=
TFL_BIKEPOINT_URL=https://api.tfl.gov.uk/BikePoint
